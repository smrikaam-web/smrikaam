{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|uploads|assets|favicon|logo|manifest|robots|sitemap).*)",
      "destination": "/index.html"
    }
  ]
}
